; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyProductName "IdentityOnChain"
#define MyAppName "IdentityOnChain Runtime"
#define MyAppVersion "1.0"
#define MyAppExeName "start-cometbft.bat"
#define StopAppExeName "stop-cometbft.bat"
#define StartAppName "StartIdentityOnChain"
#define StopAppName "StopIdentityOnChain"
;#define StartTestWebName "StartTestWebServer.bat"

;#define NodeJS32Installer "node-v22.14.0-x86.msi" ; 32 位 Node.js 安装文件
;#define NodeJS64Installer "node-v22.14.0-x64.msi" ; 64 位 Node.js 安装文件
;#define NodeJS64Init "init.bat" ; Node.js 安装package

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{C5E5CD20-6BD2-41F8-AEB5-E6CEE2A5220D}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
DefaultDirName={userappdata}\IdentityOnChain\{#MyAppName}
ChangesAssociations=yes
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline
OutputDir=D:\source\inno setup
OutputBaseFilename=IdentityOnChainRuntimeSetup
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesetraditional"; MessagesFile: "compiler:Languages\ChineseTraditional.isl"

[Tasks]
;Name: "install_nodejs"; Description: "Install Node.js if you haven't have Node.js v22.14 or higher."; GroupDescription: "Additional tasks:"; 
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "G:\setup\Runtime\*"; DestDir: "{app}\Runtime\"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "G:\setup\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "G:\setup\{#StopAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files


[Icons]
;start menu link
Name: "{group}\{#MyProductName}\{#StartAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{#MyProductName}\{#StopAppName}"; Filename: "{app}\{#StopAppExeName}"
;Name: "{group}\{#MyProductName}\{#StartTestWebName}"; Filename: "{app}\sample\{#StartTestWebName}"
Name: "{group}\{#MyProductName}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"

;desktop shortlink
Name: "{autodesktop}\{#StartAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{autodesktop}\{#StopAppName}"; Filename: "{app}\{#StopAppExeName}"; Tasks: desktopicon
;Name: "{autodesktop}\{#StartTestWebName}"; Filename: "{app}\sample\{#StartTestWebName}"; Tasks: desktopicon

[Run]
; 根据系统位数安装对应的 Node.js 安装程序
;Filename: "{app}\nodejs\{#NodeJS32Installer}"; Tasks: install_nodejs; Check: Is32Bit; Flags: shellexec waituntilterminated
;Filename: "{app}\nodejs\{#NodeJS64Installer}"; Tasks: install_nodejs; Check: Is64Bit; Flags: shellexec waituntilterminated
;Filename: "{app}\nodejs\{#NodeJS64Init}"; Flags: shellexec waituntilterminated

; MainApp
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange("IdentityOnChain", '&', '&&')}}"; Flags: shellexec postinstall skipifsilent
;Filename: "{app}\sample\{#StartTestWebName}"; Description: "{cm:LaunchProgram,{#StringChange("TestWeb", '&', '&&')}}"; Flags: shellexec postinstall skipifsilent

[CustomMessages]
; 英文
english.DeleteUserDirPrompt=Do you want to delete all application data and node data?
english.DeleteSuccess=All data has been successfully deleted.
english.DeleteFailed=Failed to delete the application data. Please delete it manually.
english.CapcityTip=Please select a partition with sufficient available space to store IdentityOnChain data.

; 繁体中文
chinesetraditional.DeleteUserDirPrompt=是否刪除應用程式數據？
chinesetraditional.DeleteSuccess=數據已成功刪除。
chinesetraditional.DeleteFailed=刪除應用程式數據目錄失敗，請手動刪除。
chinesetraditional.CapcityTip=请选择可用空间较大的分区存儲IdentityOnChain數據。

[Code]
var
  NodeJSCheckBox: TNewCheckBox;
  
// 判断系统是否为 32 位
function Is32Bit: Boolean;
begin
  Result := not IsWin64;
end;

// 判断系统是否为 64 位
function Is64Bit: Boolean;
begin
  Result := IsWin64;
end;

var
  CapacityLabel: TLabel; // 用于显示提示信息的标签

procedure InitializeWizard;
begin
  // 在选择安装路径的窗口中添加提示信息
  CapacityLabel := TLabel.Create(WizardForm);
  with CapacityLabel do
  begin
    Parent := WizardForm.SelectDirPage;
    Left := WizardForm.DirEdit.Left;
    Top := WizardForm.DirEdit.Top + WizardForm.DirEdit.Height + 10;
    Caption := CustomMessage('CapcityTip');
    Font.Color := clRed; // 设置字体颜色
    Font.Style := [fsBold]; // 设置字体样式
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    // 安装完成后显示提示信息
    //MsgBox('安装完成！', mbInformation, MB_OK);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  UserDir: string;
  ResultCode: Integer;
begin
  if CurUninstallStep = usPostUninstall then
  begin
 
    UserDir := ExpandConstant('{app}\Runtime');

    // 检查目录是否存在
    if DirExists(UserDir) then
    begin
      // 提示用户是否删除目录
      if MsgBox(CustomMessage('DeleteUserDirPrompt'), mbConfirmation, MB_YESNO) = IDYES then
      begin
        // 删除目录
        if DelTree(UserDir, True, True, True) then
          RemoveDir(UserDir)
        else
          MsgBox(CustomMessage('DeleteFailed') + UserDir, mbError, MB_OK);
      end;
    end;
  end;
end;